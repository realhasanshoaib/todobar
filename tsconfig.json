{
  "include": [
    "site/src/**/*.ts",
    "site/src/**/*.tsx",
    "convex/**/*.ts",
    "vite.config.ts",
    "eslint.config.js",
    "prettier.config.js"
  ],
  "exclude": [
    ".build",
    "dist",
    "node_modules",
    "releases",
    "convex/_generated"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./site/src/*"],
      "@/*": ["./site/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
